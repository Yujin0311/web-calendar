# 学习计划生成（/api/ai-plan）使用 DeepSeek 平台密钥。
DEEPSEEK_API_KEY=
# 图片课表识别（/api/ai/parse-schedule）使用阿里云百炼密钥。
DASHSCOPE_API_KEY=

# ===== 安全增量配置（均可选；未设置时后端使用注释中的默认值） =====

# 注册接口是否信任反向代理的 X-Forwarded-For 头。
# 部署在 Nginx/Caddy 等反代之后时设为 true，否则限流会把所有请求算到代理 IP 上。
# 直接暴露 Node 进程（无反代）时保持 false，防止攻击者伪造该头绕过限流。
TRUST_PROXY=false

# 注册限流：同一 IP 在 REGISTER_WINDOW_MINUTES 分钟内最多尝试注册 REGISTER_MAX_ATTEMPTS 次
#（成功与失败都计入），超过返回 429。
REGISTER_WINDOW_MINUTES=10
REGISTER_MAX_ATTEMPTS=3

# 登录限流：同一 IP 在窗口内最多尝试登录指定次数；成功登录清零，与注册独立计数。
LOGIN_WINDOW_MINUTES=10
LOGIN_MAX_ATTEMPTS=10

# 会话空闲超时（小时）：连续无任何请求超过该时长即失效。
SESSION_IDLE_TIMEOUT_HOURS=24

# 会话绝对超时（天）：无论是否活跃，会话最长存活时间，到期强制失效。
SESSION_ABSOLUTE_TIMEOUT_DAYS=7

# 过期会话清理定时任务：运行间隔（分钟）与每批删除条数。
SESSION_CLEANUP_INTERVAL_MINUTES=120
SESSION_CLEANUP_BATCH_SIZE=100

# 会话活跃时间刷新节流（秒）：两次请求间隔低于该值时不写库。
SESSION_ACTIVITY_REFRESH_SECONDS=300
